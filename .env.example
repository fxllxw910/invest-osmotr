# Скопируйте в .env и заполните. Файл .env в репозиторий не попадает.

# Порт и адрес сервера
PORT=4173
HOST=127.0.0.1

# Публичный адрес сервиса — подставляется в ссылки внутри SMS.
# На сервере укажите настоящий https-адрес, например:
# PUBLIC_URL=https://osmotr.example.ru
PUBLIC_URL=

# ---------------------------------------------------------------- SMS
# local   — встроенный шлюз (только для тестов, SMS никуда не уходит)
# smsru   — SMS.RU (нужен SMSRU_API_ID)
# smsc    — SMSC.RU (нужны SMSC_LOGIN и SMSC_PASSWORD)
# http    — свой шлюз по HTTP (SMS_GATEWAY_URL + SMS_GATEWAY_TOKEN)
# console — печать в журнал сервера
SMS_PROVIDER=smsru

# --- SMS.RU ---
SMSRU_API_ID=

# --- SMSC.RU ---
SMSC_LOGIN=
SMSC_PASSWORD=
# Имя отправителя, если согласовано с SMSC
SMSC_SENDER=

# --- Свой HTTP-шлюз ---
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
